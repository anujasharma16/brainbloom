// Firestore security rules for Brainbloom: each signed-in user can read and write only their own progress document.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'lang', 'updated']);
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
